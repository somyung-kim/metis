{
  "name": "metis",
  "version": "0.1.0",
  "description": "Delegate a coding task to Codex/Copilot CLI, remember what happened, and use that memory to inform the next delegation.",
  "author": {
    "name": "Somyung"
  },
  "license": "MIT",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hooks/followup.mjs\""
          }
        ]
      }
    ]
  }
}
